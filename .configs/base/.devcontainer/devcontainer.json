{
  "name": "slyc slice preview",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "containerEnv": {
    "VIRTUAL_ENV": "/opt/slyc-venv"
  },
  "remoteEnv": {
    "PATH": "/opt/slyc-venv/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": {
    "slyc": "sh .configs/base/container-bootstrap.sh"
  }
}
