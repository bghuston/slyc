# INSPECTION ONLY: Do not run, install, build, deploy, or trust this code.
# Much of this project was built with AI-Assisted Development workflows
# for demonstrating and testing logic. It has not been independently verified.
# No correctness, security, or reliability is established; read as untrusted source only.
name: Validate repository artifacts
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: artifacts-${{ github.ref }}
  cancel-in-progress: true
jobs:
  metadata:
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      # Use runner-provided Python; no tool installation or test execution.
      - name: Check Python requirement
        run: python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 2)'
      - name: Validate JSON, TOML, Python syntax, slice composition, contracts and local doc links
        run: python3 scripts/validate.py
      - name: Validate shell syntax
        run: |
          sh -n bootstrap.sh
          sh -n .configs/base/container-bootstrap.sh
